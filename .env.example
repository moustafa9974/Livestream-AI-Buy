# ─────────────────────────────────────────────────────────────────────────────
# Seen: environment variables. Copy to .env and fill in. Everything here is free.
# Only DATABASE_URL is required; every sponsor feature switches itself off (with an
# "unavailable" chip in the UI) when its keys are missing.
# Never commit .env. Never paste real (live) PayPal credentials. Sandbox only.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the app (used for PayPal return URLs and webhooks).
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Local: `docker compose up -d` gives you Postgres+pgvector with these credentials.
# Neon free tier (neon.com → New project → Connect). The pooled URL is fine here:
# migrations automatically use the direct host ("-pooler" removed), see prisma.config.ts.
# Tip: sslmode=verify-full silences the pg SSL-mode warning (same security as today).
DATABASE_URL=postgresql://seen:seen@localhost:5432/seen
# Optional: explicit direct (non-pooled) URL for migrations, for non-Neon providers.
DIRECT_DATABASE_URL=

# ── Demo controls ───────────────────────────────────────────────────────────
# DEMO_MODE shows the demo control panel and auto-logs-in "Maya Makes".
DEMO_MODE=true
# DEMO_CACHE serves seeded vision results for the demo video so it works with no Gemini quota.
DEMO_CACHE=true
# Sandbox *personal* account that receives the demo creator's payouts (Pay me now).
# developer.paypal.com → Testing Tools → Sandbox Accounts → personal account email.
DEMO_CREATOR_PAYOUT_EMAIL=
# Hours a commission waits before it can be paid out (absorbs refunds). 0 for demos, 72 for "realistic".
COMMISSION_HOLD_HOURS=0
# Default creator commission in basis points (1000 = 10%).
DEFAULT_COMMISSION_BPS=1000

# ── PayPal (sandbox; free) ──────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → Create App (Merchant).
# Enable "Payouts" on the app's features list for Pay me now.
PAYPAL_ENABLED=true
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created when you add a webhook to the sandbox app (Phase 2). Used to verify signatures.
# Without it, /api/webhooks/paypal rejects every event (fail closed).
PAYPAL_WEBHOOK_ID=
# Creator assistant uses @paypal/agent-toolkit for orders/refunds/transactions lookups.
PAYPAL_AGENT_TOOLKIT_ENABLED=true
# GET_FROM_FILE collects a shipping address (honest for physical goods). NO_SHIPPING = fewer demo steps.
CHECKOUT_SHIPPING_PREFERENCE=GET_FROM_FILE

# ── AI ──────────────────────────────────────────────────────────────────────
# gemini (default, free tier) | ollama (local, free) | claude (paid, off by default)
AI_PROVIDER=gemini
# aistudio.google.com → Get API key. Free tier: Google may use inputs to improve
# products, so only send your own demo content.
GEMINI_API_KEY=
# Model IDs change often. Checked 2026-10-08 at ai.google.dev/gemini-api/docs/models.
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding size stored in pgvector. Must match the vector(768) columns in prisma/schema.prisma.
EMBEDDING_DIM=768
# Keep below your project's real free quota (see AI Studio → Usage). Saver mode starts at 80%.
GEMINI_MAX_RPM=8
GEMINI_MAX_RPD=800
# Local fallback: install Ollama, then `ollama pull qwen2.5vl:7b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Optional, PAID. Leave empty to keep the Claude adapter off.
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-haiku-5-5

# ── Vision pipeline tuning ──────────────────────────────────────────────────
FRAME_INTERVAL_SEC=4
# Minimum dHash Hamming distance (0–64) for a frame to count as "changed".
DHASH_MIN_DISTANCE=10
# Send a frame at least this often even if nothing changed.
MAX_STALE_SECONDS=20

# ── Channel3 (similar items; free credits) ──────────────────────────────────
# trychannel3.com/developers → sign up → redeem PAYPAL-HACKATHON-2026.
CHANNEL3_ENABLED=true
CHANNEL3_API_KEY=
CHANNEL3_MAX_CALLS_PER_DAY=300

# ── KERNEL (cloud browser; $50 hackathon credits) ────────────────────────────
# Credits link is on the hackathon page. Hard caps protect the credits.
KERNEL_ENABLED=false
KERNEL_API_KEY=
KERNEL_MAX_SESSION_MINUTES=10
KERNEL_MAX_SESSIONS_PER_DAY=3

# ── Elastic (search) ────────────────────────────────────────────────────────
# Off → Postgres full-text + pgvector fallback. Dev: local Docker (Phase 4).
# Hosted demo: Elastic Cloud 14-day trial, start it in the FINAL WEEK.
ELASTIC_ENABLED=false
ELASTIC_URL=
ELASTIC_API_KEY=

# ── Astropods (stream watcher agent) ────────────────────────────────────────
# local = watcher runs in-process (default, always works). astropods = hosted agent.
WATCHER_RUNTIME=local
ASTROPODS_API_KEY=

# ── Zapier ──────────────────────────────────────────────────────────────────
# Webhooks by Zapier is a premium app: start the Pro trial in the FINAL WEEK.
# Each creator's Catch Hook URL is stored on the Creator row, not here.
ZAPIER_ENABLED=false

# ── Bryntum (schedule page; trial) ──────────────────────────────────────────
BRYNTUM_ENABLED=false

# ── Audio context (Chrome Web Speech API, runs in the browser; free) ─────────
AUDIO_CONTEXT=false
