# ─────────────────────────────────────────────────────────────────────────────
# Seen: environment variables. Copy to .env and fill in. Everything here is free.
# Only DATABASE_URL is required; every sponsor feature switches itself off (with an
# "unavailable" chip in the UI) when its keys are missing.
# Never commit .env. Never paste real (live) PayPal credentials. Sandbox only.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the app (used for PayPal return URLs and webhooks).
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Local: `docker compose up -d` gives you Postgres+pgvector with these credentials.
# Neon free tier (neon.com → New project → Connect). The pooled URL is fine here:
# migrations automatically use the direct host ("-pooler" removed), see prisma.config.ts.
# Tip: sslmode=verify-full silences the pg SSL-mode warning (same security as today).
DATABASE_URL=postgresql://seen:seen@localhost:5432/seen
# Optional: explicit direct (non-pooled) URL for migrations, for non-Neon providers.
DIRECT_DATABASE_URL=

# ── Demo controls ───────────────────────────────────────────────────────────
# DEMO_MODE shows the demo control panel and auto-logs-in "Maya Makes".
DEMO_MODE=true
# DEMO_CACHE serves seeded vision results for the demo video so it works with no Gemini quota.
DEMO_CACHE=true
# Sandbox *personal* account that receives the demo creator's payouts (Pay me now).
# developer.paypal.com → Testing Tools → Sandbox Accounts → personal account email.
DEMO_CREATOR_PAYOUT_EMAIL=
# Production: protects demo-panel actions (reset, simulate sale, …). Leave empty locally.
DEMO_PANEL_KEY=
# Hours a commission waits before it can be paid out (absorbs refunds). 0 for demos, 72 for "realistic".
COMMISSION_HOLD_HOURS=0
# Default creator commission in basis points (1000 = 10%).
DEFAULT_COMMISSION_BPS=1000

# ── PayPal (sandbox; free) ──────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → Create App (Merchant).
# Enable "Payouts" on the app's features list for Pay me now.
PAYPAL_ENABLED=true
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created when you add a webhook to the sandbox app (Phase 2). Used to verify signatures.
# Without it, /api/webhooks/paypal rejects every event (fail closed).
PAYPAL_WEBHOOK_ID=
# Creator assistant uses @paypal/agent-toolkit for orders/refunds/transactions lookups.
PAYPAL_AGENT_TOOLKIT_ENABLED=true
# GET_FROM_FILE collects a shipping address (honest for physical goods). NO_SHIPPING = fewer demo steps.
CHECKOUT_SHIPPING_PREFERENCE=GET_FROM_FILE

# ── AI ──────────────────────────────────────────────────────────────────────
# gemini (default, free tier) | ollama (local, free) | claude (paid, off by default)
AI_PROVIDER=gemini
# aistudio.google.com → Get API key. Free tier: Google may use inputs to improve
# products, so only send your own demo content.
GEMINI_API_KEY=
# Model IDs change often. Checked 2026-10-08 at ai.google.dev/gemini-api/docs/models.
# Measured 2026-10-11 on the free tier: each model has its OWN daily quota (only 20/day for
# gemini-3.5-flash and 3.6-flash), 3.8-flash was overloaded (100 s+), and the Flash-Lite
# models were as accurate on product frames and faster (1.6-3.9 s). So: Lite first, then
# fail over through other models when one is busy (503), out of quota (429) or slow.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Tried in order. A model out of daily quota is skipped until Google's reset time. Empty disables.
GEMINI_VISION_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash
# Time limit per model attempt (ms). VISION_TIMEOUT_MS caps the whole frame.
GEMINI_ATTEMPT_TIMEOUT_MS=20000

# ── OpenRouter (backup vision, free models) ────────────────────────────────
# When Gemini is busy or out of quota, frames go to OpenRouter's free vision models.
# openrouter.ai → sign in → Keys → Create key. Free models: 20 requests/min, 50/day.
# Leave empty to disable.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
OPENROUTER_MAX_RPM=15
OPENROUTER_MAX_RPD=45
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Text calls (recap, creator assistant) fail over through these, like vision.
GEMINI_TEXT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding size stored in pgvector. Must match the vector(768) columns in prisma/schema.prisma.
EMBEDDING_DIM=768
# Keep below your project's real free quota (see AI Studio → Usage). Saver mode starts at 80%.
GEMINI_MAX_RPM=8
GEMINI_MAX_RPD=150
# Embeddings have their own quota (used to dedupe detections and for search).
GEMINI_EMBED_MAX_RPM=60
GEMINI_EMBED_MAX_RPD=900
# Thinking level for the vision call: LOW | MEDIUM | HIGH, or empty to omit (gemini-3.8-flash rejects MINIMAL)
# (empty for models without thinking levels). LOW keeps latency down.
GEMINI_THINKING_LEVEL=LOW
# Per-call timeout for any vision provider.
VISION_TIMEOUT_MS=45000
# Local fallback (AI_PROVIDER=ollama): install Ollama, then `ollama pull qwen2.5vl:7b`
# (any vision model works, e.g. gemma3:4b).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Optional, PAID. Leave empty to keep the Claude adapter off (AI_PROVIDER=claude to use it).
# claude-haiku-5-5 is the cheaper option if you do enable it.
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-opus-5-5

# ── Vision pipeline tuning ──────────────────────────────────────────────────
FRAME_INTERVAL_SEC=4
# Minimum dHash Hamming distance (0–64) for a frame to count as "changed".
DHASH_MIN_DISTANCE=10
# Send a frame at least this often even if nothing changed.
MAX_STALE_SECONDS=30
# With DEMO_CACHE=true, a frame within this dHash distance of a cached frame reuses its result.
DEMO_CACHE_MAX_DISTANCE=10
# A detection needs this confidence (and 2 hits within 15s) to show on the rail.
DETECTION_MIN_CONFIDENCE=0.55
# Cap on products shown per stream.
MAX_VISIBLE_PRODUCTS=12
# Fast lane: an item at/above this confidence AND prominence shows on its FIRST sighting
# (instead of waiting for 2), so cards appear ~5-10 s after a product is held up.
# Set confidence above 1 (e.g. 2) to always require 2 sightings, as in the original spec.
DETECTION_FAST_LANE_CONFIDENCE=0.9
DETECTION_FAST_LANE_PROMINENCE=0.6
# Partner-product match thresholds (0-1). Calibrated on real Gemini embeddings:
# true matches scored 0.89-1.00, wrong ones at most 0.69. "Exact" also requires no colour conflict.
MATCH_EXACT_SCORE=0.85
MATCH_SIMILAR_SCORE=0.7
# Fallback thresholds when embeddings are unavailable (text-only scoring).
MATCH_TEXT_EXACT_SCORE=0.4
MATCH_TEXT_SIMILAR_SCORE=0.3

# ── Channel3 (similar items; free credits) ──────────────────────────────────
# trychannel3.com/developers → sign up → redeem PAYPAL-HACKATHON-2026.
CHANNEL3_ENABLED=true
CHANNEL3_API_KEY=
CHANNEL3_MAX_CALLS_PER_DAY=300

# ── KERNEL (cloud browser; $50 hackathon credits) ────────────────────────────
# Credits link is on the hackathon page. Hard caps protect the credits.
KERNEL_ENABLED=false
KERNEL_API_KEY=
KERNEL_MAX_SESSION_MINUTES=10
KERNEL_MAX_SESSIONS_PER_DAY=3

# ── Elastic (search) ────────────────────────────────────────────────────────
# Off → Postgres full-text + pgvector fallback. Dev: local Docker (Phase 4).
# Hosted demo: Elastic Cloud 14-day trial, start it in the FINAL WEEK.
ELASTIC_ENABLED=false
ELASTIC_URL=
ELASTIC_API_KEY=

# ── Astropods (stream watcher agent) ────────────────────────────────────────
# local = KERNEL watcher runs in-process (default, always works).
# astropods = the hosted watcher agent in astropods/ does the capture loop.
WATCHER_RUNTIME=local
# Shared secret the agent sends as `Authorization: Bearer …` (any long random string).
WATCHER_TOKEN=
ASTROPODS_API_KEY=

# ── Zapier ──────────────────────────────────────────────────────────────────
# Webhooks by Zapier is a premium app: start the Pro trial in the FINAL WEEK.
# Each creator's Catch Hook URL is stored on the Creator row, not here.
ZAPIER_ENABLED=false

# ── Bryntum (schedule page; trial) ──────────────────────────────────────────
BRYNTUM_ENABLED=false

# ── Audio context (Chrome Web Speech API, runs in the browser; free) ─────────
AUDIO_CONTEXT=false

# ── Live video to viewers (WebRTC, browser to browser; free) ────────────────
# The creator's browser sends video straight to each viewer: no media server, $0.
# Seen only relays the small connection handshake. If a viewer can't connect directly,
# the viewer page falls back to the latest frame snapshot (updates every few seconds).
# Note: peer-to-peer means the creator's and viewers' IP addresses are visible to each other.
LIVE_VIDEO_ENABLED=true
# Free public STUN servers (comma-separated).
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN relay for strict office/mobile networks (e.g. a free-tier TURN service).
# The credential is sent to viewers' browsers (that is how TURN works), so use a limited one.
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Each viewer is a separate upload from the creator's browser.
WEBRTC_MAX_VIEWERS=6
