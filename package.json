{
  "name": "seen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "demo:reset": "prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate",
    "test:db": "vitest run --config vitest.db.config.mts",
    "demo:cache:export": "tsx scripts/demo-cache.ts export",
    "demo:cache:import": "tsx scripts/demo-cache.ts import",
    "catalog:embed": "tsx -e \"import('./lib/search/catalog.ts').then(m=>m.embedCatalog()).then(r=>{console.log(r);process.exit(0)})\"",
    "search:index": "tsx scripts/search-index.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@base-ui/react": "^1.8.0",
    "@elastic/elasticsearch": "^9.5.1",
    "@google/genai": "^2.28.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.53.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
